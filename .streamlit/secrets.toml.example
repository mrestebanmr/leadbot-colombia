# Plantilla de secrets para Streamlit Cloud.
# En Streamlit Cloud: App → Settings → Secrets → pega este contenido (con tus valores reales).
# En local: copia este archivo a .streamlit/secrets.toml (que está en .gitignore).

GOOGLE_MAPS_API_KEY = "tu_google_maps_api_key"
GOOGLE_SHEET_ID = "tu_google_sheet_id"
OUTSCRAPER_API_KEY = "tu_outscraper_api_key_con_creditos"

# --- Necesario SOLO para exportar a Google Sheets (OAuth) en producción ---
# El client_id y client_secret salen de Google Cloud Console (credenciales OAuth tipo "Web").
# El redirect_uri DEBE ser la URL pública de tu app en Streamlit Cloud y estar
# registrada en Google Cloud Console como "URI de redireccionamiento autorizado".
[oauth_credentials]
client_id = "xxxxx.apps.googleusercontent.com"
client_secret = "tu_client_secret"
redirect_uri = "https://tu-app.streamlit.app"
